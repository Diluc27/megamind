{
  "manifest_version": 2,
  "name": "MegaMind Claude Tracker",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "activeTab",
    "https://claude.ai/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "scripts": ["shared/megamind.js", "shared/summarize.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [{
    "matches": ["https://claude.ai/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_start"
  }],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "megamind-claude-tracker@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
